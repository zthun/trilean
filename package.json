{
  "name": "trilean",
  "description": "Three state boolean logic.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/trilean"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates'",
    "test": "vitest --run --coverage",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@zthun/janitor-build-config": "^20.0.2",
    "@zthun/janitor-eslint-config": "^20.0.2",
    "@zthun/janitor-ts-config": "^20.0.0",
    "eslint": "9.39.4",
    "husky": "^9.1.7",
    "lerna": "^9.0.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "yarn@4.14.1"
}
