{
  "name": "trilean",
  "description": "Three state boolean logic.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/trilean"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates'",
    "test": "vitest --run --coverage",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@zthun/janitor-build-config": "^21.1.3",
    "@zthun/janitor-eslint-config": "^21.1.3",
    "@zthun/janitor-ts-config": "^21.1.3",
    "@zthun/janitor-vite": "^21.1.3",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lerna": "^10.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "yarn@4.18.0"
}
